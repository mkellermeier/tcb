{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitTypeAll(chore)", "group:allNonMajor"],
  "gitAuthor": "mkellermeier <michaelkellermeier@gmx.de>",
  "timezone": "Europe/Berlin",
  "packageRules": [
    {
      "description": "Held back: Astro 7 needs a native compiler that Windows app-control blocks locally; keep tooling in sync",
      "matchUpdateTypes": ["major"],
      "matchPackageNames": [
        "astro",
        "@astrojs/mdx",
        "astro-eslint-parser",
        "prettier-plugin-astro",
        "eslint-plugin-astro",
        "vite",
        "typescript"
      ],
      "enabled": false
    }
  ]
}
