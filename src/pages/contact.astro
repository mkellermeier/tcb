---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import { Icon } from 'astro-icon/components';
import MailtoForm from '~/components/MailtoForm.astro';

const metadata = {
  title: 'Kontakt',
  description: 'Kontakt zum TC Bühlertal – wir freuen uns auf deine Nachricht.',
};

const email = 'tcbuehlertal@web.de';

const help = [
  {
    title: 'Mitgliedschaft',
    description: 'Fragen zu Beiträgen, Aufnahme oder Kündigungen beantworten wir gerne.',
    icon: 'tabler:id-badge-2',
  },
  {
    title: 'Platzbuchung',
    description: 'Für Gastspieler und Anfragen zur Platzverfügbarkeit einfach mailen.',
    icon: 'tabler:calendar-check',
  },
  {
    title: 'Veranstaltungen',
    description: 'Informationen zu Turnieren, Events und Vereinsaktivitäten.',
    icon: 'tabler:calendar-event',
  },
];
---

<Layout metadata={metadata}>
  <Hero
    image={{
      src: '~/assets/images/racket-in-clay.png',
      alt: 'Kontakt TC Bühlertal',
    }}
  >
    <Fragment slot="title">Schreib uns!</Fragment>
    <Fragment slot="subtitle">
      Fragen zur Mitgliedschaft, Platzbuchung oder Vereinsaktivitäten? Wir melden uns so schnell wie möglich zurück.
    </Fragment>
  </Hero>

  <section class="max-w-5xl mx-auto px-4 py-10 space-y-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Contact info -->
      <div class="space-y-4">
        <div class="rounded-2xl border border-gray-500/20 bg-light p-6">
          <h2 class="text-lg font-semibold">Kontaktdaten</h2>
          <ul class="mt-4 space-y-3 text-sm text-muted">
            <li class="flex items-start gap-3">
              <Icon name="tabler:mail" class="w-5 h-5 text-primary shrink-0" />
              <a class="hover:underline" href={`mailto:${email}`}>{email}</a>
            </li>
            <li class="flex items-start gap-3">
              <Icon name="tabler:map-pin" class="w-5 h-5 text-primary shrink-0" />
              <span>Tennisanlage TC Bühlertal<br />Hirschbachstraße, 77830 Bühlertal</span>
            </li>
            <li class="flex items-start gap-3">
              <Icon name="tabler:brand-instagram" class="w-5 h-5 text-primary shrink-0" />
              <a
                class="hover:underline"
                href="https://www.instagram.com/tcbuehlertal/"
                target="_blank"
                rel="noopener noreferrer"
              >
                @tcbuehlertal auf Instagram
              </a>
            </li>
          </ul>
        </div>

        <div class="rounded-2xl border border-gray-500/20 bg-light p-6">
          <h2 class="text-lg font-semibold">Schnellzugriff</h2>
          <div class="mt-4 flex flex-col gap-2">
            <a class="btn btn-secondary" href="/membership">Mitglied werden</a>
            <a class="btn btn-secondary" href="/guest-players">Platz als Gastspieler buchen</a>
            <a class="btn btn-secondary" href="/board">Vorstand kontaktieren</a>
          </div>
        </div>
      </div>

      <!-- Contact form -->
      <div class="rounded-2xl border border-gray-500/20 bg-dark p-6">
        <h2 class="text-lg font-semibold">Nachricht senden</h2>
        <p class="text-muted mt-2 text-sm leading-relaxed">
          Schreib uns kurz, worum es geht – wir antworten so bald wie möglich.
        </p>
        <div class="mt-5">
          <MailtoForm
            email={email}
            subject="Anfrage TC Bühlertal"
            submitLabel="Nachricht senden"
            id="contact"
            fields={[
              { name: 'name', label: 'Name', type: 'text', required: true },
              { name: 'email', label: 'E-Mail', type: 'email', required: true },
              {
                name: 'anliegen',
                label: 'Anliegen',
                type: 'select',
                required: true,
                full: true,
                options: ['Mitgliedschaft', 'Platzbuchung / Gastspiel', 'Veranstaltungen', 'Sonstiges'],
              },
              {
                name: 'nachricht',
                label: 'Nachricht',
                type: 'textarea',
                required: true,
                placeholder: 'Deine Nachricht …',
              },
            ]}
          />
        </div>
      </div>
    </div>

    <!-- Womit können wir helfen -->
    <div>
      <h2 class="text-2xl font-semibold mb-4">Womit können wir helfen?</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {
          help.map((h) => (
            <div class="rounded-2xl border border-gray-500/20 bg-light p-5">
              <Icon name={h.icon} class="w-7 h-7 text-primary" />
              <h3 class="font-semibold mt-3">{h.title}</h3>
              <p class="text-muted mt-2 text-sm leading-relaxed">{h.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
