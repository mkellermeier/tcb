---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
import Hero from '~/components/widgets/Hero.astro';
import { getCollection } from 'astro:content';

const metadata = {
  title: 'Termine & Events',
  description: 'Turniere, Arbeitseinsätze, Feste und weitere Veranstaltungen des TC Bühlertal.',
};

const now = new Date();
const todayBerlin = now.toLocaleDateString('en-CA', { timeZone: 'Europe/Berlin' });
const dayOf = (d: Date) => d.toLocaleDateString('en-CA', { timeZone: 'Europe/Berlin' });

const allEvents = (await getCollection('events', ({ data }) => !data.draft)).sort(
  (a, b) => +a.data.startDate - +b.data.startDate
);

const upcoming = allEvents.filter((e) => dayOf(e.data.startDate) >= todayBerlin);
const past = allEvents.filter((e) => dayOf(e.data.startDate) < todayBerlin).reverse();

const pastByYear = new Map<string, typeof past>();
for (const e of past) {
  const year = dayOf(e.data.startDate).slice(0, 4);
  pastByYear.set(year, [...(pastByYear.get(year) ?? []), e]);
}

function formatDate(d: Date) {
  return d.toLocaleDateString('de-DE', { weekday: 'long', day: '2-digit', month: 'long', year: 'numeric' });
}

function formatShort(d: Date) {
  return d.toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' });
}
---

<Layout metadata={metadata}>
  <Hero
    image={{
      src: '~/assets/images/beer-on-court.png',
      alt: 'Events & Termine',
    }}
  >
    <Fragment slot="title">Termine & Events</Fragment>
    <Fragment slot="subtitle">
      Turniere, Arbeitseinsätze, Feste und alles, was uns als Verein zusammenbringt.
    </Fragment>
  </Hero>

  <section class="max-w-5xl mx-auto px-4 py-10 space-y-10">
    <!-- Kommende Termine -->
    <div>
      <div class="flex flex-wrap items-baseline justify-between gap-2 mb-4">
        <h2 class="text-2xl font-semibold">Kommende Termine</h2>
        <span class="inline-flex items-center gap-3 text-sm">
          <Icon name="tabler:calendar-plus" class="w-4 h-4 text-primary" />
          <a class="text-primary hover:underline" href={`webcal://${Astro.site?.host}/termine.ics`}
            >Kalender abonnieren</a
          >
          <a class="text-muted hover:underline" href="/termine.ics" download>.ics</a>
        </span>
      </div>

      {
        upcoming.length === 0 ? (
          <div class="rounded-2xl border border-gray-500/20 bg-light p-6">
            <p class="text-muted text-sm">Aktuell sind keine Termine veröffentlicht.</p>
            <p class="text-muted text-sm mt-2">
              Die nächsten Spiele findest du im Spielplan, bei Fragen melde dich direkt bei uns.
            </p>
            <div class="mt-4 flex flex-wrap gap-3">
              <a class="btn btn-primary" href="/matches">
                Zum Spielplan
              </a>
              <a class="btn btn-secondary" href="/contact">
                Kontakt
              </a>
            </div>
          </div>
        ) : (
          <div class="space-y-3">
            {upcoming.map((e) => (
              <a
                href={`/events/${e.id}`}
                class="block rounded-2xl border border-gray-500/20 bg-light p-5 hover:shadow-md transition"
              >
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
                  <div>
                    <h3 class="font-semibold text-page">{e.data.title}</h3>
                    <div class="mt-1 text-sm text-muted">
                      {formatDate(e.data.startDate)}
                      {e.data.endDate && e.data.endDate.toDateString() !== e.data.startDate.toDateString()
                        ? ` – ${formatShort(e.data.endDate)}`
                        : ''}
                      {e.data.time ? ` · ${e.data.time} Uhr` : ''}
                    </div>
                    {e.data.location ? <div class="mt-1 text-sm text-muted">{e.data.location}</div> : null}
                    {e.data.description ? (
                      <p class="mt-2 text-sm text-muted leading-relaxed">{e.data.description}</p>
                    ) : null}
                  </div>
                  <div class="shrink-0 text-sm text-primary whitespace-nowrap">Details →</div>
                </div>
              </a>
            ))}
          </div>
        )
      }
    </div>

    <!-- Vergangene Termine -->
    {
      past.length > 0 && (
        <div>
          <h2 class="text-2xl font-semibold mb-4 text-muted">Vergangene Termine</h2>
          {[...pastByYear].map(([year, events]) => (
            <div class="mb-6">
              <h3 class="text-sm font-semibold text-muted mb-2">{year}</h3>
              <div class="space-y-2">
                {events.map((e) => (
                  <a
                    href={`/events/${e.id}`}
                    class="block rounded-2xl border border-gray-500/20 bg-dark p-4 opacity-70 hover:opacity-90 transition"
                  >
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                      <div class="font-medium text-page text-sm">{e.data.title}</div>
                      <div class="text-sm text-muted whitespace-nowrap">
                        {formatShort(e.data.startDate)}
                        {e.data.location ? ` · ${e.data.location}` : ''}
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      )
    }
  </section>
</Layout>
