---
import Layout from '~/layouts/PageLayout.astro';
import Gallery from '../../components/common/Gallery.astro';
import { getCollection, render } from 'astro:content';
import defaultPostImage from '~/assets/images/hero-blackforest.png';

export async function getStaticPaths() {
  const entries = await getCollection('posts', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const metadata = {
  title: entry.data.title,
  description: entry.data.excerpt ?? `${entry.data.title} – Bericht des TC Bühlertal.`,
};

const fmt = (d: Date) => new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: 'long', year: 'numeric' }).format(d);
---

<Layout metadata={metadata}>
  <!-- Post-Hero -->
  <section class="post-hero relative overflow-hidden -mt-[76px]">
    <div class="post-hero-bg absolute inset-0">
      <img
        src={entry.data.coverImage ?? entry.data.gallery?.[0]?.src ?? defaultPostImage.src}
        alt={entry.data.title}
        loading="eager"
        style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover"
      />
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
    <div class="relative z-10 flex flex-col items-center justify-center h-full text-center px-4 pt-[76px]">
      <h1
        class="text-4xl md:text-6xl font-bold leading-tight tracking-tight mb-4"
        style="color: #fff; text-shadow: 0 2px 16px rgba(0,0,0,0.6)"
      >
        {entry.data.title}
      </h1>
      {
        entry.data.excerpt && (
          <p
            class="text-lg md:text-xl max-w-2xl"
            style="color: rgba(255,255,255,0.85); text-shadow: 0 1px 8px rgba(0,0,0,0.5)"
          >
            {entry.data.excerpt}
          </p>
        )
      }
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 py-10 space-y-10">
    <!-- Back -->
    <div>
      <a class="btn btn-secondary" href="/posts">← Zurück zu den Beiträgen</a>
    </div>

    <!-- Meta box -->
    <div class="rounded-2xl border border-gray-500/20 bg-light p-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
        <div>
          <div class="text-muted">Datum</div>
          <div class="font-semibold text-page">{fmt(entry.data.date)}</div>
        </div>

        {
          entry.data.tags?.length ? (
            <div>
              <div class="text-muted">Tags</div>
              <div class="mt-2 flex flex-wrap gap-2">
                {entry.data.tags.map((t) => (
                  <span class="rounded-full border border-gray-500/20 bg-dark px-3 py-1 text-xs text-muted">{t}</span>
                ))}
              </div>
            </div>
          ) : null
        }
      </div>

      {
        entry.data.meta?.length ? (
          <div class="mt-6 border-t border-gray-500/20 pt-4 space-y-2">
            {entry.data.meta.map((m) => (
              <div class="flex gap-3">
                <div class="w-28 shrink-0 text-muted">{m.label}</div>
                <div class="text-page">{m.value}</div>
              </div>
            ))}
          </div>
        ) : null
      }
    </div>

    <!-- Content -->
    <div class="rounded-2xl border border-gray-500/20 bg-light p-6">
      <article class="prose dark:prose-invert max-w-none">
        <Content />
      </article>
    </div>

    <!-- Gallery -->
    {
      entry.data.gallery?.length ? (
        <div class="rounded-2xl border border-gray-500/20 bg-light p-6">
          <Gallery items={entry.data.gallery} />
        </div>
      ) : null
    }
  </section>
</Layout>

<style>
  .post-hero {
    height: 65vh;
    min-height: 380px;
  }

  @keyframes kenburns {
    0% {
      transform: scale(1) translate(0%, 0%);
    }
    100% {
      transform: scale(1.22) translate(-3%, 2%);
    }
  }

  .post-hero-bg {
    animation: kenburns 22s linear infinite alternate;
    transform-origin: center center;
  }
</style>
