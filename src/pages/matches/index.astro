---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';

import { getCollection } from 'astro:content';

const metadata = {
  title: 'Spielbetrieb',
  description: 'Begegnungen, Teams und Ergebnisse.',
};

const allMatches = (await getCollection('matches'))
  .filter((m) => !m.data.draft)
  .sort((a, b) => +a.data.matchDate - +b.data.matchDate);

const teams = Array.from(new Set(allMatches.map((m) => m.data.team))).sort((a, b) => a.localeCompare(b, 'de-DE'));

// Group by competition, sorted so that newest season appears first
const competitionOrder = Array.from(new Set(allMatches.map((m) => m.data.competition ?? 'Sonstige'))).sort((a, b) => {
  // Sort by latest match date in that competition (descending)
  const latestA = Math.max(
    ...allMatches.filter((m) => (m.data.competition ?? 'Sonstige') === a).map((m) => +m.data.matchDate)
  );
  const latestB = Math.max(
    ...allMatches.filter((m) => (m.data.competition ?? 'Sonstige') === b).map((m) => +m.data.matchDate)
  );
  return latestB - latestA;
});

function formatDate(d: Date) {
  return d.toLocaleDateString('de-DE', {
    weekday: 'short',
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
    timeZone: 'Europe/Berlin',
  });
}

function formatTime(d: Date) {
  const t = d.toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Berlin' });
  return t !== '00:00' ? t : null;
}

function resultInfo(result: string | undefined) {
  if (!result) return null;
  const parts = result.split(':').map(Number);
  if (parts.length !== 2 || parts.some(isNaN)) return null;
  const [a, b] = parts;
  return { label: result, won: a > b };
}
---

<Layout metadata={metadata}>
  <Hero
    image={{
      src: '~/assets/images/racket-in-clay.png',
      alt: 'Tennis Spielbetrieb',
    }}
  >
    <Fragment slot="title"> Spielbetrieb </Fragment>
    <Fragment slot="subtitle"> Medenspiele, Begegnungen und Ergebnisse unserer Teams. </Fragment>
  </Hero>

  <section class="max-w-5xl mx-auto px-4 py-10 space-y-6">
    <!-- Team Tabs -->
    <div class="flex flex-wrap gap-2">
      <button
        class="tab-btn px-4 py-1.5 rounded-full text-sm border border-gray-500/20 bg-light text-page transition hover:bg-white/10 active-tab"
        data-team="__all__"
      >
        Alle Teams
      </button>
      {
        teams.map((t) => (
          <button
            class="tab-btn px-4 py-1.5 rounded-full text-sm border border-gray-500/20 bg-light text-muted transition hover:bg-white/10"
            data-team={t}
          >
            {t}
          </button>
        ))
      }
    </div>

    <!-- Upcoming toggle + count -->
    <div class="flex items-center justify-between">
      <label class="flex items-center gap-2 text-sm cursor-pointer select-none">
        <input id="upcomingOnly" type="checkbox" checked class="h-4 w-4 accent-primary" />
        Nur kommende Spiele
      </label>
      <span id="resultCount" class="text-sm text-muted"></span>
    </div>

    <!-- Groups by competition -->
    {
      competitionOrder.map((competition) => {
        const matches = allMatches.filter((m) => (m.data.competition ?? 'Sonstige') === competition);
        return (
          <div class="competition-group" data-competition={competition}>
            <h2 class="text-base font-semibold text-muted uppercase tracking-wide mb-3">{competition}</h2>
            <div class="rounded-2xl border border-gray-500/20 overflow-hidden">
              <table class="w-full text-sm">
                <tbody>
                  {matches.map((m) => {
                    const ri = resultInfo(m.data.result);
                    const time = formatTime(m.data.matchDate);
                    return (
                      <tr
                        class="border-t border-gray-500/20 first:border-t-0 hover:bg-white/5 transition cursor-pointer"
                        data-team={m.data.team}
                        data-date={m.data.matchDate.toISOString()}
                        onclick={`window.location='/matches/${m.slug}'`}
                      >
                        {/* Datum */}
                        <td class="p-3 whitespace-nowrap w-32">
                          <div class="text-page">{formatDate(m.data.matchDate)}</div>
                          {time && <div class="text-muted text-xs">{time} Uhr</div>}
                        </td>

                        {/* Begegnung */}
                        <td class="p-3">
                          <div class="font-medium text-page">
                            {m.data.team}
                            <span class="ml-2 text-xs font-normal text-muted border border-gray-500/30 rounded px-1.5 py-0.5">
                              {m.data.homeAway === 'home' ? 'Heim' : 'Auswärts'}
                            </span>
                          </div>
                          <div class="text-muted text-xs mt-0.5">
                            vs. {m.data.opponent}
                            {m.data.location && <span class="ml-2 opacity-60">· {m.data.location}</span>}
                          </div>
                        </td>

                        {/* Ergebnis */}
                        <td class="p-3 text-right whitespace-nowrap">
                          {ri ? (
                            <span
                              class={`inline-block px-2.5 py-1 rounded-full text-xs font-semibold ${
                                ri.won ? 'bg-green-500/20 text-green-400' : 'bg-red-500/20 text-red-400'
                              }`}
                            >
                              {ri.label}
                            </span>
                          ) : (
                            <span class="text-muted text-xs">ausstehend</span>
                          )}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>
        );
      })
    }

    <p id="emptyMsg" class="hidden text-center text-muted py-8">Keine Spiele gefunden.</p>
  </section>

  <script is:inline>
    const now = new Date();
    const upcomingOnly = document.getElementById('upcomingOnly');
    const resultCount = document.getElementById('resultCount');
    const emptyMsg = document.getElementById('emptyMsg');
    const tabBtns = document.querySelectorAll('.tab-btn');
    const rows = Array.from(document.querySelectorAll('tbody tr'));
    const groups = Array.from(document.querySelectorAll('.competition-group'));

    let activeTeam = '__all__';

    function applyFilters() {
      const onlyUpcoming = upcomingOnly.checked;
      let visible = 0;

      for (const row of rows) {
        const rowTeam = row.getAttribute('data-team');
        const rowDate = new Date(row.getAttribute('data-date'));
        const teamOk = activeTeam === '__all__' || rowTeam === activeTeam;
        const dateOk = !onlyUpcoming || rowDate >= now;
        const show = teamOk && dateOk;
        row.style.display = show ? '' : 'none';
        if (show) visible++;
      }

      // Show/hide group headers based on visible rows
      for (const group of groups) {
        const hasVisible = Array.from(group.querySelectorAll('tbody tr')).some((r) => r.style.display !== 'none');
        group.style.display = hasVisible ? '' : 'none';
      }

      resultCount.textContent = visible === 1 ? '1 Spiel' : visible + ' Spiele';
      emptyMsg.classList.toggle('hidden', visible > 0);
    }

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeTeam = btn.getAttribute('data-team');
        tabBtns.forEach((b) => {
          b.classList.toggle('active-tab', b === btn);
          b.classList.toggle('text-page', b === btn);
          b.classList.toggle('text-muted', b !== btn);
        });
        applyFilters();
      });
    });

    upcomingOnly.addEventListener('change', applyFilters);
    applyFilters();
  </script>

  <style>
    .active-tab {
      background-color: rgb(var(--aw-color-primary) / 0.15);
      border-color: rgb(var(--aw-color-primary) / 0.4);
      color: rgb(var(--aw-color-primary));
    }
  </style>
</Layout>
