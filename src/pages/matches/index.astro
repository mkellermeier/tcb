---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import MatchTable from '~/components/MatchTable.astro';
import { getCollection } from 'astro:content';

const metadata = {
  title: 'Spielbetrieb',
  description: 'Begegnungen, Teams und Ergebnisse.',
};

const allMatches = (await getCollection('matches')).filter((m) => !m.data.draft);

const now = new Date();
const todayBerlin = now.toLocaleDateString('en-CA', { timeZone: 'Europe/Berlin' });
const dayOf = (d: Date) => d.toLocaleDateString('en-CA', { timeZone: 'Europe/Berlin' });

// Aktuelle Saison = Wettbewerb des zeitlich spätesten Spiels (i. d. R. das letzte angesetzte Spiel)
const latestMatch = [...allMatches].sort((a, b) => +b.data.matchDate - +a.data.matchDate)[0];
const currentSeason = latestMatch?.data.competition ?? null;

const upcoming = allMatches
  .filter((m) => dayOf(m.data.matchDate) >= todayBerlin && !m.data.result)
  .sort((a, b) => +a.data.matchDate - +b.data.matchDate);
const past = allMatches
  .filter((m) => m.data.result || dayOf(m.data.matchDate) < todayBerlin)
  .sort((a, b) => +b.data.matchDate - +a.data.matchDate);

const pastCurrent = past.filter((m) => m.data.competition === currentSeason);
const pastArchive = past.filter((m) => m.data.competition !== currentSeason);

const teams = Array.from(new Set(allMatches.map((m) => m.data.team))).sort((a, b) => a.localeCompare(b, 'de-DE'));

function groupByCompetition(matches: typeof allMatches) {
  const map = new Map<string, typeof allMatches>();
  for (const m of matches) {
    const key = m.data.competition ?? 'Sonstige';
    if (!map.has(key)) map.set(key, []);
    map.get(key)!.push(m);
  }
  return map;
}

const upcomingGroups = groupByCompetition(upcoming);
const pastCurrentGroups = groupByCompetition(pastCurrent);
const pastArchiveGroups = groupByCompetition(pastArchive);
---

<Layout metadata={metadata}>
  <Hero
    image={{
      src: '~/assets/images/racket-in-clay.png',
      alt: 'Tennis Spielbetrieb',
    }}
  >
    <Fragment slot="title"> Spielbetrieb </Fragment>
    <Fragment slot="subtitle"> Medenspiele, Begegnungen und Ergebnisse unserer Teams. </Fragment>
  </Hero>

  <section class="max-w-5xl mx-auto px-4 py-10 space-y-8">
    <!-- Team filter -->
    <div class="flex flex-wrap gap-2">
      <button
        class="team-btn active-team px-4 py-1.5 rounded-full text-sm border border-gray-500/20 bg-light transition"
        data-team="__all__"
      >
        Alle Teams
      </button>
      {
        teams.map((t) => (
          <button
            class="team-btn px-4 py-1.5 rounded-full text-sm border border-gray-500/20 bg-light text-muted transition hover:bg-white/10"
            data-team={t}
          >
            {t}
          </button>
        ))
      }
    </div>

    <!-- Letzte Ergebnisse (aktuelle Saison) -->
    <div class="match-section space-y-6">
      <h2 class="text-xl font-bold text-page">Letzte Ergebnisse</h2>
      <MatchTable groups={pastCurrentGroups} mode="result" />
      <p class:list={['section-empty text-center text-muted py-8', { hidden: pastCurrentGroups.size > 0 }]}>
        Noch keine Ergebnisse.
      </p>
    </div>

    <!-- Kommende Spiele -->
    <div class="match-section space-y-6">
      <h2 class="text-xl font-bold text-page">Kommende Spiele</h2>
      <MatchTable groups={upcomingGroups} mode="upcoming" />
      <p class:list={['section-empty text-center text-muted py-8', { hidden: upcomingGroups.size > 0 }]}>
        Keine kommenden Spiele.
      </p>
    </div>

    <!-- Frühere Saisons -->
    {
      pastArchiveGroups.size > 0 && (
        <div class="match-section space-y-6">
          <h2 class="text-xl font-bold text-page">Frühere Saisons</h2>
          <MatchTable groups={pastArchiveGroups} mode="result" />
          <p class="section-empty text-center text-muted py-8 hidden">Keine Spiele für dieses Team.</p>
        </div>
      )
    }
  </section>

  <script is:inline>
    function initMatchFilter() {
      const teamBtns = document.querySelectorAll('.team-btn');
      const sections = document.querySelectorAll('.match-section');
      if (!sections.length) return;

      let activeTeam = '__all__';

      function applyFilters() {
        sections.forEach((section) => {
          let sectionVisible = 0;
          section.querySelectorAll('.match-group').forEach((group) => {
            let groupVisible = 0;
            group.querySelectorAll('.match-row').forEach((row) => {
              const show = activeTeam === '__all__' || row.getAttribute('data-team') === activeTeam;
              row.style.display = show ? '' : 'none';
              if (show) groupVisible++;
            });
            group.style.display = groupVisible > 0 ? '' : 'none';
            sectionVisible += groupVisible;
          });
          const empty = section.querySelector('.section-empty');
          if (empty) {
            empty.textContent =
              sectionVisible > 0
                ? ''
                : activeTeam === '__all__'
                  ? empty.dataset.emptyAll
                  : 'Keine Spiele für dieses Team.';
            empty.classList.toggle('hidden', sectionVisible > 0);
          }
        });
      }

      teamBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          activeTeam = btn.getAttribute('data-team');
          teamBtns.forEach((b) => {
            const isActive = b === btn;
            b.classList.toggle('active-team', isActive);
            b.classList.toggle('text-muted', !isActive);
          });
          applyFilters();
        });
      });

      document.querySelectorAll('.section-empty').forEach((p) => {
        p.dataset.emptyAll = p.textContent.trim();
      });

      applyFilters();
    }

    document.addEventListener('astro:page-load', initMatchFilter);
  </script>

  <style>
    .active-team {
      background-color: rgb(var(--aw-color-primary) / 0.15);
      border-color: rgb(var(--aw-color-primary) / 0.4);
      color: rgb(var(--aw-color-primary));
    }
  </style>
</Layout>
