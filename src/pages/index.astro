---
import Layout from '~/layouts/PageLayout.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Icon } from 'astro-icon/components';
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import defaultPostImage from '~/assets/images/hero-blackforest.png';
import courtOverview from '~/assets/images/court-overview.png';
import { sponsors } from '~/data/sponsors';

const metadata = {
  title: 'TC Bühlertal',
  ignoreTitleTemplate: true,
  description:
    'TC Bühlertal e.V. – Tennisclub im Schwarzwald, gegründet 1965. Vier Sandplätze, Mannschaften, Termine und Platzbuchung in Bühlertal.',
};

const now = new Date();
const todayBerlin = now.toLocaleDateString('en-CA', { timeZone: 'Europe/Berlin' });
const dayOf = (d: Date) => d.toLocaleDateString('en-CA', { timeZone: 'Europe/Berlin' });

// ---------- helpers ----------
function formatShortDate(d: Date) {
  return d.toLocaleDateString('de-DE', { weekday: 'short', day: '2-digit', month: '2-digit' });
}

function formatPostDate(d: Date) {
  return d.toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' });
}

function daysBetween(a: Date, b: Date) {
  const da = new Date(a.getFullYear(), a.getMonth(), a.getDate()).getTime();
  const db = new Date(b.getFullYear(), b.getMonth(), b.getDate()).getTime();
  return Math.round((db - da) / (1000 * 60 * 60 * 24));
}

function relativeLabel(d: Date) {
  const diff = daysBetween(now, d);
  if (diff === 0) return 'Heute';
  if (diff === 1) return 'Morgen';
  if (diff > 1 && diff <= 7) return `in ${diff} Tagen`;
  return '';
}

function homeAwayLabel(v: 'home' | 'away') {
  return v === 'home' ? 'Heim' : 'Auswärts';
}

// ---------- matches ----------
const matchesAll = (await getCollection('matches', ({ data }) => !data.draft)).sort(
  (a, b) => +a.data.matchDate - +b.data.matchDate
);

const upcomingAll = matchesAll.filter((m) => dayOf(m.data.matchDate) >= todayBerlin && !m.data.result);
const featured = upcomingAll.find((m) => !m.data.dateTbd);
const followingMatches = upcomingAll.filter((m) => m !== featured).slice(0, 3);
const teamCount = new Set(matchesAll.map((m) => m.data.team)).size;
const matchTime = (d: Date) => {
  const t = d.toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Berlin' });
  return t !== '00:00' ? t : null;
};
const recentMatches = matchesAll
  .filter((m) => m.data.result || dayOf(m.data.matchDate) < todayBerlin)
  .slice(-3)
  .reverse();

function resultInfo(result: string | undefined) {
  if (!result) return null;
  const parts = result.split(':').map(Number);
  if (parts.length !== 2 || parts.some(isNaN)) return null;
  const outcome: 'win' | 'loss' | 'draw' = parts[0] > parts[1] ? 'win' : parts[0] < parts[1] ? 'loss' : 'draw';
  return { label: result, outcome };
}

const outcomeClass: Record<'win' | 'loss' | 'draw', string> = {
  win: 'bg-green-500/20 text-green-400',
  loss: 'bg-red-500/20 text-red-400',
  draw: 'bg-yellow-500/20 text-yellow-400',
};

// ---------- events ----------
const eventsAll = (await getCollection('events', ({ data }) => !data.draft)).sort(
  (a, b) => +a.data.startDate - +b.data.startDate
);

const upcomingEvents = eventsAll.filter((e) => dayOf(e.data.startDate) >= todayBerlin).slice(0, 3);

// ---------- latest posts ----------
const postsAll = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const latestPosts = postsAll.slice(0, 3);

// ---------- facts + sponsors ----------
const facts = [
  { value: '1965', label: 'Gegründet' },
  { value: '4', label: 'Sandplätze' },
  { value: String(teamCount), label: 'Mannschaften' },
  { value: 'Apr–Okt', label: 'Saison' },
];
const homeSponsors = sponsors.slice(0, 8);
---

<Layout metadata={metadata}>
  <!-- Cinematic hero -->
  <section class="hero-cinematic relative overflow-hidden -mt-[76px]">
    <Picture
      src={courtOverview}
      alt="Tennis im Schwarzwald"
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1920, 2560]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero-bg absolute inset-0 w-full h-full object-cover"
    />
    <!-- gradient overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/25 to-black/55"></div>
    <!-- content -->
    <div class="relative z-10 flex flex-col items-center justify-center h-full text-center px-4 pt-[76px]">
      <h1
        class="text-5xl md:text-7xl font-bold leading-tight tracking-tight mb-4"
        style="color: #fff; text-shadow: 0 2px 16px rgba(0,0,0,0.6)"
      >
        Tennis im <span class="text-primary">Schwarzwald</span>
      </h1>
      <p
        class="text-lg md:text-xl mb-8 max-w-xl"
        style="color: rgba(255,255,255,0.85); text-shadow: 0 1px 8px rgba(0,0,0,0.5)"
      >
        Willkommen beim TC Bühlertal – eurem Tennisclub seit 1965.
      </p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a href="/tennis-ausprobieren" class="hero-btn hero-btn-primary">
          <Icon name="tabler:ball-tennis" class="w-4 h-4 mr-2 inline-block" />
          Tennis ausprobieren
        </a>
        <a href="/matches" class="hero-btn hero-btn-secondary">
          <Icon name="tabler:trophy" class="w-4 h-4 mr-2 inline-block" />
          Spiele &amp; Ergebnisse
        </a>
      </div>
    </div>
  </section>

  <style>
    .hero-cinematic {
      height: 70vh;
      min-height: 460px;
    }

    @keyframes kenburns {
      0% {
        transform: scale(1) translate(0%, 0%);
      }
      100% {
        transform: scale(1.22) translate(-3%, 2%);
      }
    }

    .hero-bg {
      animation: kenburns 22s linear infinite alternate;
      transform-origin: center center;
    }

    @media (prefers-reduced-motion: reduce) {
      .hero-bg {
        animation: none;
      }
    }

    .hero-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 9999px;
      font-weight: 500;
      font-size: 1rem;
      padding: 0.75rem 1.75rem;
      transition:
        background-color 0.2s,
        border-color 0.2s;
      cursor: pointer;
      text-decoration: none;
      white-space: nowrap;
    }

    .hero-btn-primary {
      background-color: rgb(var(--aw-color-primary));
      color: #fff;
      border: 2px solid rgb(var(--aw-color-primary));
    }

    .hero-btn-primary:hover {
      background-color: rgb(var(--aw-color-secondary));
      border-color: rgb(var(--aw-color-secondary));
    }

    .hero-btn-secondary {
      background-color: rgba(255, 255, 255, 0.12);
      color: #fff;
      border: 2px solid rgba(255, 255, 255, 0.55);
      backdrop-filter: blur(4px);
    }

    .hero-btn-secondary:hover {
      background-color: rgba(255, 255, 255, 0.22);
      border-color: rgba(255, 255, 255, 0.8);
    }
  </style>

  <section class="max-w-5xl mx-auto px-4 py-10 space-y-12">
    <!-- Nächstes Spiel -->
    {
      featured ? (
        <div class="rounded-3xl border border-primary/30 bg-light p-6 md:p-8">
          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
            <div class="min-w-0">
              <p class="text-sm font-semibold uppercase tracking-widest text-primary">Nächstes Spiel</p>
              <h2 class="text-3xl md:text-4xl font-bold mt-2 leading-tight">
                {featured.data.team} <span class="text-muted font-normal">vs.</span> {featured.data.opponent}
              </h2>
              <p class="mt-3 text-muted flex flex-wrap items-center gap-x-5 gap-y-1">
                <span class="inline-flex items-center gap-1.5">
                  <Icon name="tabler:calendar" class="w-4 h-4 text-primary" />
                  {featured.data.matchDate.toLocaleDateString('de-DE', {
                    weekday: 'long',
                    day: '2-digit',
                    month: 'long',
                    timeZone: 'Europe/Berlin',
                  })}
                  {matchTime(featured.data.matchDate) ? ` · ${matchTime(featured.data.matchDate)} Uhr` : ''}
                </span>
                {featured.data.location && (
                  <span class="inline-flex items-center gap-1.5">
                    <Icon name="tabler:map-pin" class="w-4 h-4 text-primary" />
                    {featured.data.location}
                  </span>
                )}
                <span class="rounded-full border border-gray-500/20 bg-dark px-3 py-0.5 text-sm">
                  {homeAwayLabel(featured.data.homeAway)}
                </span>
              </p>
            </div>
            <div class="md:text-right shrink-0">
              <div
                class="text-3xl md:text-4xl font-bold text-primary"
                data-countdown
                data-start={featured.data.matchDate.toISOString()}
              >
                {relativeLabel(featured.data.matchDate) || formatShortDate(featured.data.matchDate)}
              </div>
              <a class="btn btn-secondary mt-3" href={`/matches/${featured.id}`}>
                Details
              </a>
            </div>
          </div>

          {followingMatches.length > 0 && (
            <ul class="mt-6 pt-5 border-t border-gray-500/20 grid grid-cols-1 md:grid-cols-3 gap-3">
              {followingMatches.map((m) => (
                <li>
                  <a
                    href={`/matches/${m.id}`}
                    class="block rounded-xl border border-gray-500/20 bg-dark p-3 hover:border-gray-400/40 hover:bg-white/5 transition"
                  >
                    <div class="text-sm font-semibold text-page">
                      {m.data.team} <span class="font-normal text-muted">vs. {m.data.opponent}</span>
                    </div>
                    <div class="text-sm text-muted mt-0.5">
                      {m.data.dateTbd ? 'Termin offen' : formatShortDate(m.data.matchDate)} ·{' '}
                      {homeAwayLabel(m.data.homeAway)}
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          )}

          <div class="mt-5 text-sm">
            <a class="text-primary hover:underline" href="/matches">
              Kompletter Spielplan →
            </a>
          </div>
        </div>
      ) : (
        <div class="rounded-3xl border border-gray-500/20 bg-light p-6 md:p-8">
          <p class="text-sm font-semibold uppercase tracking-widest text-primary">Nächstes Spiel</p>
          <p class="mt-2 text-muted">
            Aktuell ist kein Spiel angesetzt. Alle Ergebnisse findest du im{' '}
            <a class="text-primary hover:underline" href="/matches">
              Spielplan
            </a>
            .
          </p>
        </div>
      )
    }

    <!-- Zahlen -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {
        facts.map((f) => (
          <div class="rounded-2xl border border-gray-500/20 bg-light p-5 text-center">
            <div class="text-3xl font-bold text-primary">{f.value}</div>
            <div class="text-sm text-muted mt-1">{f.label}</div>
          </div>
        ))
      }
    </div>

    <!-- Neueste Berichte -->
    {
      latestPosts.length > 0 && (
        <div>
          <div class="flex items-baseline justify-between gap-3 mb-4">
            <h2 class="text-2xl font-semibold">Neueste Berichte</h2>
            <a class="text-sm text-primary hover:underline" href="/posts">
              Alle Berichte →
            </a>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {latestPosts.map((p) => (
              <a
                href={`/posts/${p.id}`}
                class="group rounded-2xl border border-gray-500/20 bg-light overflow-hidden hover:border-gray-400/40 transition"
              >
                <div class="overflow-hidden">
                  <img
                    src={p.data.coverImage ?? p.data.gallery?.[0]?.src ?? defaultPostImage.src}
                    alt={p.data.title}
                    loading="lazy"
                    class="aspect-video w-full object-cover object-[center_30%] group-hover:scale-[1.03] transition duration-500"
                  />
                </div>
                <div class="p-4">
                  <div class="text-sm text-muted">{formatPostDate(p.data.date)}</div>
                  <h3 class="font-semibold text-page mt-1 leading-snug">{p.data.title}</h3>
                  {p.data.excerpt && <p class="text-sm text-muted mt-2 line-clamp-2">{p.data.excerpt}</p>}
                </div>
              </a>
            ))}
          </div>
        </div>
      )
    }

    <!-- Ergebnisse + Termine -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="rounded-2xl border border-gray-500/20 bg-light p-5">
        <div class="flex items-center justify-between gap-3 mb-3">
          <div class="flex items-center gap-2">
            <Icon name="tabler:trophy" class="w-5 h-5 text-primary shrink-0" />
            <h3 class="font-semibold text-page">Letzte Ergebnisse</h3>
          </div>
          <a class="text-sm text-primary hover:underline" href="/matches"> Alle → </a>
        </div>
        {
          recentMatches.length === 0 ? (
            <p class="text-muted text-sm">Noch keine Ergebnisse.</p>
          ) : (
            <ul class="space-y-2">
              {recentMatches.map((m) => {
                const ri = resultInfo(m.data.result);
                return (
                  <li>
                    <a
                      href={`/matches/${m.id}`}
                      class="flex items-center justify-between gap-3 rounded-xl border border-gray-500/20 bg-dark p-3 hover:border-gray-400/40 hover:bg-white/5 transition"
                    >
                      <div class="min-w-0">
                        <div class="text-sm font-semibold text-page">
                          {m.data.team} <span class="font-normal text-muted">vs. {m.data.opponent}</span>
                        </div>
                        <div class="text-sm text-muted mt-0.5">
                          {formatShortDate(m.data.matchDate)} · {homeAwayLabel(m.data.homeAway)}
                        </div>
                      </div>
                      {ri && (
                        <span
                          class={`shrink-0 px-2.5 py-1 rounded-full text-sm font-semibold ${outcomeClass[ri.outcome]}`}
                        >
                          {ri.label}
                        </span>
                      )}
                    </a>
                  </li>
                );
              })}
            </ul>
          )
        }
      </div>

      <div class="rounded-2xl border border-gray-500/20 bg-light p-5">
        <div class="flex items-center justify-between gap-3 mb-3">
          <div class="flex items-center gap-2">
            <Icon name="tabler:calendar-event" class="w-5 h-5 text-primary shrink-0" />
            <h3 class="font-semibold text-page">Nächste Termine</h3>
          </div>
          <a class="text-sm text-primary hover:underline" href="/events"> Alle → </a>
        </div>
        {
          upcomingEvents.length === 0 ? (
            <p class="text-muted text-sm">
              Aktuell keine Termine veröffentlicht. Die nächsten Spiele findest du im{' '}
              <a class="text-primary hover:underline" href="/matches">
                Spielplan
              </a>
              .
            </p>
          ) : (
            <ul class="space-y-2">
              {upcomingEvents.map((e) => (
                <li>
                  <a
                    href={`/events/${e.id}`}
                    class="block rounded-xl border border-gray-500/20 bg-dark p-3 hover:border-gray-400/40 hover:bg-white/5 transition"
                  >
                    <div class="text-sm font-semibold text-page">{e.data.title}</div>
                    <div class="text-sm text-muted mt-0.5">
                      {formatShortDate(e.data.startDate)}
                      {e.data.time ? ` · ${e.data.time} Uhr` : ''}
                      {e.data.location ? ` · ${e.data.location}` : ''}
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>

    <!-- Sponsoren -->
    <div>
      <div class="flex items-baseline justify-between gap-3 mb-4">
        <h2 class="text-2xl font-semibold">Unsere Partner</h2>
        <a class="text-sm text-primary hover:underline" href="/sponsors"> Alle Sponsoren → </a>
      </div>
      <ul class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        {
          homeSponsors.map((s) => (
            <li>
              <a
                href="/sponsors"
                title={s.name}
                class="flex h-16 items-center justify-center rounded-xl bg-white p-2 hover:opacity-90 transition"
              >
                <img
                  src={s.logo}
                  alt={s.name}
                  loading="lazy"
                  class="max-h-full max-w-full object-contain"
                  onerror="this.parentElement.parentElement.style.display='none'"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CallToAction
    actions={[
      { variant: 'primary', text: 'Tennis ausprobieren', href: '/tennis-ausprobieren', icon: 'tabler:ball-tennis' },
      { text: 'Mitglied werden', href: '/membership', icon: 'tabler:user-plus' },
      { text: 'Kontakt', href: '/contact' },
    ]}
  >
    <Fragment slot="title">Lust auf Tennis?</Fragment>
    <Fragment slot="subtitle"
      >Probier es aus – als Gast, als neues Mitglied oder als Jugendlicher. Wir freuen uns auf dich.</Fragment
    >
  </CallToAction>

  <script is:inline>
    document.querySelectorAll('[data-countdown]').forEach((el) => {
      const start = new Date(el.getAttribute('data-start'));
      const day = (d) => new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime();
      const diff = Math.round((day(start) - day(new Date())) / 86400000);
      if (diff === 0) el.textContent = 'Heute';
      else if (diff === 1) el.textContent = 'Morgen';
      else if (diff > 1) el.textContent = 'in ' + diff + ' Tagen';
    });
  </script>
</Layout>
