---
import Layout from '~/layouts/PageLayout.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import defaultPostImage from '~/assets/images/hero-blackforest.png';
import courtOverview from '~/assets/images/court-overview.png';

const metadata = {
  title: 'TC Bühlertal',
  ignoreTitleTemplate: true,
  description:
    'TC Bühlertal e.V. – Tennisclub im Schwarzwald, gegründet 1965. Sechs Sandplätze, Mannschaften, Termine und Platzbuchung in Bühlertal.',
};

const now = new Date();
const todayBerlin = now.toLocaleDateString('en-CA', { timeZone: 'Europe/Berlin' });
const dayOf = (d: Date) => d.toLocaleDateString('en-CA', { timeZone: 'Europe/Berlin' });

// ---------- helpers ----------
function formatShortDate(d: Date) {
  return d.toLocaleDateString('de-DE', { weekday: 'short', day: '2-digit', month: '2-digit' });
}

function formatPostDate(d: Date) {
  return d.toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' });
}

function daysBetween(a: Date, b: Date) {
  const da = new Date(a.getFullYear(), a.getMonth(), a.getDate()).getTime();
  const db = new Date(b.getFullYear(), b.getMonth(), b.getDate()).getTime();
  return Math.round((db - da) / (1000 * 60 * 60 * 24));
}

function relativeLabel(d: Date) {
  const diff = daysBetween(now, d);
  if (diff === 0) return 'Heute';
  if (diff === 1) return 'Morgen';
  if (diff > 1 && diff <= 7) return `in ${diff} Tagen`;
  return '';
}

function homeAwayLabel(v: 'home' | 'away') {
  return v === 'home' ? 'Heim' : 'Auswärts';
}

// ---------- matches ----------
const matchesAll = (await getCollection('matches', ({ data }) => !data.draft)).sort(
  (a, b) => +a.data.matchDate - +b.data.matchDate
);

const upcomingMatches = matchesAll
  .filter((m) => dayOf(m.data.matchDate) >= todayBerlin && !m.data.result)
  .slice(0, 3);
const recentMatches = matchesAll
  .filter((m) => m.data.result || dayOf(m.data.matchDate) < todayBerlin)
  .slice(-3)
  .reverse();

function resultInfo(result: string | undefined) {
  if (!result) return null;
  const parts = result.split(':').map(Number);
  if (parts.length !== 2 || parts.some(isNaN)) return null;
  return { label: result, won: parts[0] > parts[1] };
}

// ---------- events ----------
const eventsAll = (await getCollection('events', ({ data }) => !data.draft)).sort(
  (a, b) => +a.data.startDate - +b.data.startDate
);

const upcomingEvents = eventsAll.filter((e) => dayOf(e.data.startDate) >= todayBerlin).slice(0, 3);

// ---------- latest posts ----------
const postsAll = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const latestPosts = postsAll.slice(0, 3);
---

<Layout metadata={metadata}>
  <!-- Cinematic hero -->
  <section class="hero-cinematic relative overflow-hidden -mt-[76px]">
    <img
      src={courtOverview.src}
      alt="Tennis im Schwarzwald"
      class="hero-bg absolute inset-0 w-full h-full object-cover"
      loading="eager"
    />
    <!-- gradient overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/25 to-black/55"></div>
    <!-- content -->
    <div class="relative z-10 flex flex-col items-center justify-center h-full text-center px-4 pt-[76px]">
      <h1
        class="text-5xl md:text-7xl font-bold leading-tight tracking-tight mb-4"
        style="color: #fff; text-shadow: 0 2px 16px rgba(0,0,0,0.6)"
      >
        Tennis im <span class="text-primary">Schwarzwald</span>
      </h1>
      <p
        class="text-lg md:text-xl mb-8 max-w-xl"
        style="color: rgba(255,255,255,0.85); text-shadow: 0 1px 8px rgba(0,0,0,0.5)"
      >
        Willkommen beim TC Bühlertal – eurem Tennisclub seit 1965.
      </p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a href="/matches" class="hero-btn hero-btn-primary">
          <Icon name="tabler:trophy" class="w-4 h-4 mr-2 inline-block" />
          Spiele &amp; Ergebnisse
        </a>
        <a href="/events" class="hero-btn hero-btn-secondary">
          <Icon name="tabler:calendar-event" class="w-4 h-4 mr-2 inline-block" />
          Termine
        </a>
      </div>
    </div>
  </section>

  <style>
    .hero-cinematic {
      height: 85vh;
      min-height: 480px;
    }

    @keyframes kenburns {
      0% {
        transform: scale(1) translate(0%, 0%);
      }
      100% {
        transform: scale(1.22) translate(-3%, 2%);
      }
    }

    .hero-bg {
      animation: kenburns 22s linear infinite alternate;
      transform-origin: center center;
    }

    .hero-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 9999px;
      font-weight: 500;
      font-size: 1rem;
      padding: 0.75rem 1.75rem;
      transition:
        background-color 0.2s,
        border-color 0.2s;
      cursor: pointer;
      text-decoration: none;
      white-space: nowrap;
    }

    .hero-btn-primary {
      background-color: rgb(var(--aw-color-primary));
      color: #fff;
      border: 2px solid rgb(var(--aw-color-primary));
    }

    .hero-btn-primary:hover {
      background-color: rgb(var(--aw-color-secondary));
      border-color: rgb(var(--aw-color-secondary));
    }

    .hero-btn-secondary {
      background-color: rgba(255, 255, 255, 0.12);
      color: #fff;
      border: 2px solid rgba(255, 255, 255, 0.55);
      backdrop-filter: blur(4px);
    }

    .hero-btn-secondary:hover {
      background-color: rgba(255, 255, 255, 0.22);
      border-color: rgba(255, 255, 255, 0.8);
    }
  </style>

  <section class="max-w-5xl mx-auto px-4 py-10 space-y-10">
    <!-- Stat bar -->
    <div
      class="flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-gray-500/20 bg-light px-6 py-4"
    >
      <div class="flex flex-wrap gap-6 text-sm">
        <div class="flex items-center gap-2">
          <Icon name="tabler:calendar" class="w-4 h-4 text-primary shrink-0" />
          <span class="font-semibold text-page">1965</span>
          <span class="text-muted">gegründet</span>
        </div>
        <div class="hidden sm:block w-px bg-gray-500/20 self-stretch"></div>
        <div class="flex items-center gap-2">
          <Icon name="tabler:ball-tennis" class="w-4 h-4 text-primary shrink-0" />
          <span class="font-semibold text-page">6</span>
          <span class="text-muted">Sandplätze</span>
        </div>
        <div class="hidden sm:block w-px bg-gray-500/20 self-stretch"></div>
        <div class="flex items-center gap-2">
          <Icon name="tabler:home" class="w-4 h-4 text-primary shrink-0" />
          <span class="text-muted">Clubhaus & Terrasse</span>
        </div>
        <div class="hidden sm:block w-px bg-gray-500/20 self-stretch"></div>
        <div class="flex items-center gap-2">
          <Icon name="tabler:map-pin" class="w-4 h-4 text-primary shrink-0" />
          <span class="font-semibold text-page">Bühlertal</span>
          <span class="text-muted">Schwarzwald</span>
        </div>
      </div>
      <a href="/club" class="text-sm text-primary hover:underline whitespace-nowrap">Mehr über uns →</a>
    </div>

    <!-- Aktuelles -->
    <div>
      <h2 class="text-2xl font-semibold mb-4">Aktuelles</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Spiele -->
        <div class="rounded-2xl border border-gray-500/20 bg-light p-5 space-y-5">
          <!-- Nächste Spiele -->
          <div>
            <div class="flex items-center justify-between gap-3 mb-3">
              <div class="flex items-center gap-2">
                <Icon name="tabler:calendar-event" class="w-5 h-5 text-primary shrink-0" />
                <h3 class="font-semibold text-page">Nächste Spiele</h3>
              </div>
              <a class="text-sm text-primary hover:underline" href="/matches">Spielplan →</a>
            </div>
            {
              upcomingMatches.length === 0 ? (
                <p class="text-muted text-sm">Keine kommenden Spiele.</p>
              ) : (
                <ul class="space-y-2">
                  {upcomingMatches.map((m) => {
                    const timeStr = m.data.matchDate.toLocaleTimeString('de-DE', {
                      hour: '2-digit',
                      minute: '2-digit',
                      timeZone: 'Europe/Berlin',
                    });
                    const hasTime = timeStr !== '00:00';
                    return (
                      <li>
                        <a
                          href={`/matches/${m.slug}`}
                          class="flex items-start justify-between gap-3 rounded-xl border border-gray-500/20 bg-dark p-3 hover:border-gray-400/40 hover:bg-white/5 transition"
                        >
                          <div>
                            <div class="flex flex-wrap items-center gap-2">
                              <span class="text-sm font-semibold text-page">{m.data.team}</span>
                              <span class="rounded-full border border-gray-500/20 px-2 py-0.5 text-xs text-muted">
                                {homeAwayLabel(m.data.homeAway)}
                              </span>
                              {relativeLabel(m.data.matchDate) && (
                                <span class="rounded-full bg-primary/10 border border-primary/20 px-2 py-0.5 text-xs text-primary">
                                  {relativeLabel(m.data.matchDate)}
                                </span>
                              )}
                            </div>
                            <div class="mt-1 text-xs text-muted">
                              {formatShortDate(m.data.matchDate)}
                              {hasTime ? ` · ${timeStr} Uhr` : ''} · vs. {m.data.opponent}
                            </div>
                          </div>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              )
            }
          </div>

          <!-- Divider -->
          <div class="border-t border-gray-500/20"></div>

          <!-- Letzte Ergebnisse -->
          <div>
            <div class="flex items-center justify-between gap-3 mb-3">
              <div class="flex items-center gap-2">
                <Icon name="tabler:trophy" class="w-5 h-5 text-primary shrink-0" />
                <h3 class="font-semibold text-page">Letzte Ergebnisse</h3>
              </div>
              <a class="text-sm text-primary hover:underline" href="/matches#ergebnisse">Alle →</a>
            </div>
            {
              recentMatches.length === 0 ? (
                <p class="text-muted text-sm">Noch keine Ergebnisse.</p>
              ) : (
                <ul class="space-y-2">
                  {recentMatches.map((m) => {
                    const ri = resultInfo(m.data.result);
                    return (
                      <li>
                        <a
                          href={`/matches/${m.slug}`}
                          class="flex items-start justify-between gap-3 rounded-xl border border-gray-500/20 bg-dark p-3 hover:border-gray-400/40 hover:bg-white/5 transition"
                        >
                          <div>
                            <div class="flex flex-wrap items-center gap-2">
                              <span class="text-sm font-semibold text-page">{m.data.team}</span>
                              <span class="rounded-full border border-gray-500/20 px-2 py-0.5 text-xs text-muted">
                                {homeAwayLabel(m.data.homeAway)}
                              </span>
                            </div>
                            <div class="mt-1 text-xs text-muted">
                              {formatShortDate(m.data.matchDate)} · vs. {m.data.opponent}
                            </div>
                          </div>
                          {ri && (
                            <span
                              class={`shrink-0 self-center px-2.5 py-1 rounded-full text-xs font-semibold ${ri.won ? 'bg-green-500/20 text-green-400' : 'bg-red-500/20 text-red-400'}`}
                            >
                              {ri.label}
                            </span>
                          )}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              )
            }
          </div>
        </div>

        <!-- Rechte Spalte: Termine + Neueste Berichte -->
        <div class="flex flex-col gap-4">
          <!-- Nächste Termine -->
          <div class="rounded-2xl border border-gray-500/20 bg-light p-5">
            <div class="flex items-center justify-between gap-3 mb-4">
              <div class="flex items-center gap-2">
                <Icon name="tabler:calendar-event" class="w-5 h-5 text-primary shrink-0" />
                <h3 class="font-semibold text-page">Nächste Termine</h3>
              </div>
              <a class="text-sm text-primary hover:underline" href="/events">Alle →</a>
            </div>
            {
              upcomingEvents.length === 0 ? (
                <p class="text-muted text-sm">Aktuell keine Termine.</p>
              ) : (
                <ul class="space-y-2">
                  {upcomingEvents.map((e) => (
                    <li>
                      <a
                        href={`/events/${e.slug}`}
                        class="flex items-start justify-between gap-3 rounded-xl border border-gray-500/20 bg-dark p-3 hover:border-gray-400/40 hover:bg-white/5 transition"
                      >
                        <div>
                          <div class="flex flex-wrap items-center gap-2">
                            <span class="text-sm font-semibold text-page">{e.data.title}</span>
                            {relativeLabel(e.data.startDate) && (
                              <span class="rounded-full bg-primary/10 border border-primary/20 px-2 py-0.5 text-xs text-primary">
                                {relativeLabel(e.data.startDate)}
                              </span>
                            )}
                          </div>
                          <div class="mt-1 text-xs text-muted">
                            {formatShortDate(e.data.startDate)}
                            {e.data.time ? ` · ${e.data.time} Uhr` : ''}
                            {e.data.location ? ` · ${e.data.location}` : ''}
                          </div>
                        </div>
                      </a>
                    </li>
                  ))}
                </ul>
              )
            }
          </div>

          <!-- Neueste Berichte -->
          <div class="rounded-2xl border border-gray-500/20 bg-light p-5">
            <div class="flex items-center justify-between gap-3 mb-4">
              <div class="flex items-center gap-2">
                <Icon name="tabler:news" class="w-5 h-5 text-primary shrink-0" />
                <h3 class="font-semibold text-page">Neueste Berichte</h3>
              </div>
              <a class="text-sm text-primary hover:underline" href="/posts">Alle →</a>
            </div>
            {
              latestPosts.length === 0 ? (
                <p class="text-muted text-sm">Noch keine Berichte.</p>
              ) : (
                <ul class="space-y-2">
                  {latestPosts.slice(0, 3).map((p) => {
                    const previewImg = p.data.coverImage ?? p.data.gallery?.[0]?.src ?? defaultPostImage.src;
                    return (
                      <li>
                        <a
                          href={`/posts/${p.slug}`}
                          class="flex items-center gap-3 rounded-xl border border-gray-500/20 bg-dark p-3 hover:border-gray-400/40 hover:bg-white/5 transition group"
                        >
                          <img
                            src={previewImg}
                            alt={p.data.title}
                            loading="lazy"
                            class="h-12 w-12 rounded-lg object-cover object-[center_30%] shrink-0"
                          />
                          <div class="min-w-0">
                            <div class="text-sm font-semibold text-page leading-snug line-clamp-1">{p.data.title}</div>
                            <div class="text-xs text-muted mt-0.5">{formatPostDate(p.data.date)}</div>
                          </div>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <CallToAction
    actions={[
      { variant: 'primary', text: 'Platz buchen', href: '/guest-players', icon: 'tabler:calendar' },
      { text: 'Mitglied werden', href: '/membership', icon: 'tabler:user-plus' },
      { text: 'Kontakt', href: '/contact' },
    ]}
  >
    <Fragment slot="title">Lust auf ein Match?</Fragment>
    <Fragment slot="subtitle"
      >Buche deinen Platz online, werde Mitglied oder melde dich bei Fragen direkt bei uns.</Fragment
    >
  </CallToAction>
</Layout>
