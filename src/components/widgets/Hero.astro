---
import Button from '~/components/ui/Button.astro';
import { findImage } from '~/utils/images';

import type { Hero as Props } from '~/types';
import type { ImageMetadata } from 'astro';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,

  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),
  image = await Astro.slots.render('image'),

  id,
} = Astro.props;

let bgSrc: string | undefined;
let bgAlt = '';

if (image && typeof image !== 'string') {
  const resolved = await findImage((image as { src: string; alt?: string }).src);
  bgAlt = (image as { src: string; alt?: string }).alt ?? '';
  if (typeof resolved === 'string') {
    bgSrc = resolved;
  } else if (resolved && typeof resolved === 'object') {
    bgSrc = (resolved as ImageMetadata).src;
  }
}
---

<section class="hero-cinematic relative overflow-hidden -mt-[76px]" {...id ? { id } : {}}>
  {
    bgSrc ? (
      <div class="hero-bg absolute inset-0">
        <img
          src={bgSrc}
          alt={bgAlt}
          loading="eager"
          style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover"
        />
      </div>
    ) : image && typeof image === 'string' ? (
      <div class="hero-bg absolute inset-0">
        <Fragment set:html={image} />
      </div>
    ) : null
  }

  <!-- gradient overlay -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-black/25 to-black/55"></div>

  <!-- content -->
  <div class="relative z-10 flex flex-col items-center justify-center h-full text-center px-4 pt-[76px]">
    {
      tagline && (
        <p class="text-sm font-bold tracking-widest uppercase mb-3" style="color: rgba(255,255,255,0.7)">
          {tagline}
        </p>
      )
    }
    {
      title && (
        <h1
          class="text-4xl md:text-6xl font-bold leading-tight tracking-tight mb-4"
          style="color: #fff; text-shadow: 0 2px 16px rgba(0,0,0,0.6)"
          set:html={title}
        />
      )
    }
    {
      subtitle && (
        <p
          class="text-lg md:text-xl mb-8 max-w-2xl"
          style="color: rgba(255,255,255,0.85); text-shadow: 0 1px 8px rgba(0,0,0,0.5)"
          set:html={subtitle}
        />
      )
    }
    {
      actions && (
        <div class="flex flex-col sm:flex-row gap-3">
          {Array.isArray(actions) ? (
            actions.map((action) => (
              <div class="flex w-full sm:w-auto">
                <Button {...(action || {})} class="w-full sm:mb-0" />
              </div>
            ))
          ) : (
            <Fragment set:html={actions} />
          )}
        </div>
      )
    }
    {content && <Fragment set:html={content} />}
  </div>
</section>

<style>
  .hero-cinematic {
    height: 65vh;
    min-height: 380px;
  }

  @keyframes kenburns {
    0% {
      transform: scale(1) translate(0%, 0%);
    }
    100% {
      transform: scale(1.22) translate(-3%, 2%);
    }
  }

  .hero-bg {
    animation: kenburns 22s linear infinite alternate;
    transform-origin: center center;
  }
</style>
