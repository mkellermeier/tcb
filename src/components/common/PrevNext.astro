---
interface Item {
  href: string;
  title: string;
  meta?: string;
}

export interface Props {
  prev?: Item;
  next?: Item;
  prevLabel: string;
  nextLabel: string;
  backHref: string;
  backLabel: string;
}

const { prev, next, prevLabel, nextLabel, backHref, backLabel } = Astro.props;
---

<nav aria-label="Weitere Einträge" class="space-y-4">
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {
      prev ? (
        <a
          href={prev.href}
          class="rounded-2xl border border-gray-500/20 bg-light p-4 hover:border-primary/40 transition"
        >
          <div class="text-xs text-muted">← {prevLabel}</div>
          <div class="font-semibold text-page mt-1">{prev.title}</div>
          {prev.meta && <div class="text-sm text-muted mt-0.5">{prev.meta}</div>}
        </a>
      ) : (
        <div />
      )
    }
    {
      next && (
        <a
          href={next.href}
          class="rounded-2xl border border-gray-500/20 bg-light p-4 text-right hover:border-primary/40 transition sm:col-start-2"
        >
          <div class="text-xs text-muted">{nextLabel} →</div>
          <div class="font-semibold text-page mt-1">{next.title}</div>
          {next.meta && <div class="text-sm text-muted mt-0.5">{next.meta}</div>}
        </a>
      )
    }
  </div>
  <div>
    <a class="btn btn-secondary" href={backHref}>← {backLabel}</a>
  </div>
</nav>
